{
  "name": "logline-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter logline dev",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint && eslint scripts eslint.config.ts --max-warnings 0",
    "lint:fix": "eslint packages scripts eslint.config.ts --fix",
    "clean": "nx reset && node scripts/clean.mjs",
    "type-check": "nx run-many -t type-check && tsc --noEmit",
    "format:check": "prettier packages scripts docs skills .vitepress .github .changeset .release '*.json' '*.ts' '*.md' '*.yaml' --check",
    "changeset": "changeset",
    "version:prepare": "node scripts/prepare-version.mjs",
    "release:beta": "node scripts/publish-release.mjs",
    "verify": "node scripts/verify.mjs",
    "test:release": "node --test --test-reporter=tap scripts/*.test.mjs",
    "docs:dev": "node scripts/prepare-docs.mjs && vitepress dev",
    "docs:build": "node scripts/prepare-docs.mjs && vitepress build && node scripts/check-docs.mjs",
    "docs:preview": "vitepress preview",
    "pack:logline": "pnpm --dir packages/logline pack --pack-destination ../.."
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "nx": "24.0.0",
    "prettier": "^3.1.1",
    "semver": "7.7.3",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.46.4",
    "vitepress": "1.6.4"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0",
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "dependencies": {}
}
