{
  "name": "logline",
  "version": "2.0.0-alpha.0",
  "description": "Structured frontend logging with Vite integration, IndexedDB persistence, and startup error capture.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./auto-import": {
      "types": "./dist/auto-import.d.ts",
      "import": "./dist/auto-import.js",
      "require": "./dist/auto-import.cjs"
    },
    "./plugin/*": {
      "types": "./dist/plugins/*/index.d.ts",
      "import": "./dist/plugins/*/index.js",
      "require": "./dist/plugins/*/index.cjs"
    },
    "./html-interop": {
      "types": "./dist/html-interop.d.ts",
      "import": "./dist/html-interop.js",
      "require": "./dist/html-interop.cjs"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js",
      "require": "./dist/vite-plugin.cjs"
    },
    "./docs/*": "./docs/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "skills",
    "README.zh-CN.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "pnpm run type-check && vite build",
    "test": "vitest run",
    "lint": "eslint src vite.config.ts eslint.config.ts --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "format:check": "prettier src docs skills scripts .github *.json *.ts *.md --check",
    "prepack": "pnpm run build",
    "prepublishOnly": "node scripts/check-prerelease.mjs && pnpm run type-check && pnpm run lint && pnpm run test",
    "release:next": "pnpm publish --publish-branch v2 --tag next --access public"
  },
  "keywords": [
    "logging",
    "frontend",
    "typescript",
    "vite",
    "indexeddb",
    "error-monitoring"
  ],
  "author": "latel <latelx64@icloud.com>",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.26.3",
    "@babel/traverse": "^7.26.3",
    "@babel/types": "^7.26.3",
    "esbuild": "^0.25.11",
    "magic-string": "^0.30.12",
    "source-map-js": "^1.2.1"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.55.0",
    "@types/babel__traverse": "^7.20.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.46.4",
    "unplugin-dts": "1.0.0-beta.6",
    "vite": "^6.2.1",
    "vite-plugin-externalize-deps": "^0.10.0",
    "vitest": "^4.0.13",
    "@types/node": "^24.10.1",
    "prettier": "^3.1.1",
    "jiti": "^2.6.1"
  },
  "peerDependencies": {
    "vite": "^6.2.1 || ^7.0.0 || ^8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tellok/logline.git"
  },
  "bugs": {
    "url": "https://github.com/tellok/logline/issues"
  },
  "homepage": "https://github.com/tellok/logline/tree/v2#readme",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
