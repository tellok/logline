# Copy to .env (mode 0600). Generate TWO DIFFERENT secrets using openssl rand -hex 32.
# No credentials are provided. Keep both secrets server-side and out of source control.
# Source checkout: docker compose up -d --build --wait; then GET http://127.0.0.1:4318/ready.
# PostgreSQL is private and persistent in the Compose data volume. `down` keeps it; `down -v` erases it.
LOGLINE_ADMIN_TOKEN=
# Use hex for the local password so it can be embedded in the database URL safely.
POSTGRES_PASSWORD=
# Compose listens only on loopback. Put an authenticated TLS ingress in front for remote clients.
LOGLINE_PORT=4318
# Optional authenticated MCP endpoint (same bearer scopes as the HTTP API).
LOGLINE_MCP_ENABLED=false
# Per pod; multiply pool sizes by the maximum rolling replica count when sizing Postgres.
INGEST_CONCURRENCY=12
QUERY_CONCURRENCY=4
# Cluster-wide quotas per project and UTC minute. Retention is measured from receipt.
PROJECT_EVENTS_PER_MINUTE=60000
PROJECT_BYTES_PER_MINUTE=67108864
RETENTION_DAYS=30
# Per request, before persistence (body bytes and events).
MAX_BODY_BYTES=1048576
MAX_BATCH_EVENTS=500
# Optional in the source checkout: run an existing release with `docker compose pull && docker compose up --no-build -d --wait`.
# Leave unset when building locally; never rebuild on top of a release tag.
# LOGLINE_IMAGE=ghcr.io/tellok/logline-server:<release-tag>
